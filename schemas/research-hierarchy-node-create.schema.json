{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "HierarchyNodeType": {
      "enum": [
        "EPISODE",
        "RESULT_FAMILY",
        "DEPENDENCY_METHOD",
        "CLAIM_ATOM",
        "FORMAL_TARGET_BUNDLE",
        "MANUSCRIPT_SECTION",
        "SOURCE_FILE",
        "CHALLENGE_CONFIG"
      ],
      "title": "HierarchyNodeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "node_type": {
      "$ref": "#/$defs/HierarchyNodeType"
    },
    "label": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "parent_refs": {
      "items": {
        "type": "string"
      },
      "title": "Parent Refs",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "node_type",
    "label",
    "actor"
  ],
  "title": "ResearchHierarchyNodeCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/research-hierarchy-node-create.schema.json"
}
