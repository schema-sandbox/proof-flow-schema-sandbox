{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "reviewer_family": {
      "default": "",
      "title": "Reviewer Family",
      "type": "string"
    },
    "organization": {
      "default": "",
      "title": "Organization",
      "type": "string"
    },
    "editor": {
      "default": "",
      "title": "Editor",
      "type": "string"
    },
    "source_material_refs": {
      "items": {
        "type": "string"
      },
      "title": "Source Material Refs",
      "type": "array"
    },
    "formatter": {
      "default": "",
      "title": "Formatter",
      "type": "string"
    },
    "checker": {
      "default": "",
      "title": "Checker",
      "type": "string"
    },
    "scope": {
      "default": "",
      "title": "Scope",
      "type": "string"
    },
    "unchecked_items": {
      "items": {
        "type": "string"
      },
      "title": "Unchecked Items",
      "type": "array"
    },
    "independence_group": {
      "default": "",
      "title": "Independence Group",
      "type": "string"
    },
    "correlation_flags": {
      "items": {
        "type": "string"
      },
      "title": "Correlation Flags",
      "type": "array"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "actor"
  ],
  "title": "ReviewLineageCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/review-lineage-create.schema.json"
}
