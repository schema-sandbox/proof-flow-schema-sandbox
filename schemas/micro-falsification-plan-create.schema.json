{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "target_ref": {
      "title": "Target Ref",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Hypotheses",
      "type": "array"
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "stopping_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Stopping Conditions",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "target_ref",
    "hypotheses",
    "tests",
    "actor"
  ],
  "title": "MicroFalsificationPlanCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/micro-falsification-plan-create.schema.json"
}
