{
  "$defs": {
    "PluginRunStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ],
      "title": "PluginRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "plugin_id": {
      "title": "Plugin Id",
      "type": "string"
    },
    "plugin_version": {
      "title": "Plugin Version",
      "type": "string"
    },
    "route_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Id"
    },
    "branch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Id"
    },
    "status": {
      "$ref": "#/$defs/PluginRunStatus"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "runtime_version": {
      "title": "Runtime Version",
      "type": "string"
    },
    "isolation_level": {
      "title": "Isolation Level",
      "type": "string"
    },
    "timeout_seconds": {
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "source_artifact_ref": {
      "title": "Source Artifact Ref",
      "type": "string"
    },
    "input_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Artifact Refs",
      "type": "array"
    },
    "stdout_artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stdout Artifact Ref"
    },
    "stderr_artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stderr Artifact Ref"
    },
    "produced_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Produced Artifact Refs",
      "type": "array"
    },
    "output_truncated": {
      "default": false,
      "title": "Output Truncated",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "plugin_id",
    "plugin_version",
    "status",
    "command",
    "runtime_version",
    "isolation_level",
    "timeout_seconds",
    "source_artifact_ref",
    "started_at",
    "completed_at"
  ],
  "title": "PluginRunRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/plugin-run.schema.json"
}
