{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ClaimSourceClass": {
      "enum": [
        "DIRECT_OBSERVATION",
        "TOOL_RESULT",
        "FORMAL_EXECUTION",
        "AUTHOR_REPORTED",
        "LEGACY",
        "UNKNOWN"
      ],
      "title": "ClaimSourceClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A source-addressed claim proposal; acceptance is performed by M1.",
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "statement": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "source_class": {
      "$ref": "#/$defs/ClaimSourceClass",
      "default": "UNKNOWN"
    },
    "interpretation": {
      "default": "",
      "maxLength": 16000,
      "title": "Interpretation",
      "type": "string"
    },
    "definitions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Definitions",
      "type": "object"
    },
    "quantifiers": {
      "items": {
        "type": "string"
      },
      "title": "Quantifiers",
      "type": "array"
    },
    "scope": {
      "additionalProperties": true,
      "title": "Scope",
      "type": "object"
    },
    "relations": {
      "items": {
        "type": "string"
      },
      "title": "Relations",
      "type": "array"
    },
    "open_obligation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Open Obligation Refs",
      "type": "array"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "statement",
    "actor"
  ],
  "title": "ClaimAtomCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/claim-atom-create.schema.json"
}
