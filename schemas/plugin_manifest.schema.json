{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/plugin-manifest-0.1.json",
  "title": "ProofFlow Plugin Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "plugin_id",
    "name",
    "version",
    "plugin_type",
    "execution_mode",
    "entrypoint",
    "permissions",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "plugin_type": {
      "enum": [
        "COMPUTE",
        "SEARCH",
        "FORMALIZE",
        "VISUALIZE",
        "VIDEO",
        "IMPORT_EXPORT",
        "LITERATURE"
      ]
    },
    "execution_mode": {
      "enum": [
        "local_process",
        "container",
        "remote"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "permissions": {
      "type": "object",
      "required": [
        "network",
        "project_read",
        "project_write"
      ],
      "properties": {
        "network": {
          "type": "boolean"
        },
        "project_read": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "project_write": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "environment_variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64
        },
        "output_mb": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
