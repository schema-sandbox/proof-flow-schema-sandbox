{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DossierField": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "default": null,
          "title": "Value"
        },
        "source_class": {
          "$ref": "#/$defs/DossierSourceClass",
          "default": "UNKNOWN"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "title": "DossierField",
      "type": "object"
    },
    "DossierSourceClass": {
      "enum": [
        "RAW_EVENT",
        "TOOL_ARTIFACT",
        "HUMAN_REVIEW",
        "MODEL_REPORTED",
        "LEGACY",
        "UNKNOWN"
      ],
      "title": "DossierSourceClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "episode_ref": {
      "title": "Episode Ref",
      "type": "string"
    },
    "fields": {
      "additionalProperties": {
        "$ref": "#/$defs/DossierField"
      },
      "title": "Fields",
      "type": "object"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "dossier_id": {
      "format": "uuid",
      "title": "Dossier Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "dossier_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Dossier Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "episode_ref",
    "fields",
    "actor",
    "dossier_id",
    "project_id",
    "dossier_sha256",
    "created_at"
  ],
  "title": "ResearchEpisodeDossierV2Record",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/research-episode-dossier-v2.schema.json"
}
