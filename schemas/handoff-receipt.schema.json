{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "packet_id": {
      "format": "uuid",
      "title": "Packet Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "reason": {
      "default": "",
      "title": "Reason",
      "type": "string"
    },
    "from_revision": {
      "minimum": 0,
      "title": "From Revision",
      "type": "integer"
    },
    "to_revision": {
      "minimum": 0,
      "title": "To Revision",
      "type": "integer"
    },
    "acceptance_actor": {
      "$ref": "#/$defs/Actor"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "packet_id",
    "project_id",
    "accepted",
    "from_revision",
    "to_revision",
    "acceptance_actor",
    "accepted_at"
  ],
  "title": "HandoffReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/handoff-receipt.schema.json"
}
