{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "EpistemicDeltaType": {
      "enum": [
        "TARGET_CLARIFIED",
        "ASSUMPTION_CHANGED",
        "ROUTE_CREATED",
        "ROUTE_OBSTRUCTED",
        "ROUTE_REVIVED",
        "COUNTEREXAMPLE_FOUND",
        "BRIDGE_RESULT_CREATED",
        "TOOL_EVIDENCE_ADDED",
        "HANDOFF_REUSED",
        "VISUAL_PATTERN_NOTED",
        "HUMAN_INTERVENTION",
        "SESSION_RECORDED",
        "NO_STATE_CHANGE"
      ],
      "title": "EpistemicDeltaType",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "default": "0.6",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "caused_by": {
      "items": {
        "type": "string"
      },
      "title": "Caused By",
      "type": "array"
    },
    "route_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Id"
    },
    "branch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch Id"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "epistemic_delta": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Epistemic Delta"
    },
    "epistemic_delta_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/EpistemicDeltaType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Hash"
    },
    "event_hash": {
      "title": "Event Hash",
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "batch_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Id"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "project_id",
    "timestamp",
    "actor",
    "event_hash"
  ],
  "title": "EventRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/event.schema.json"
}
