{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/research-event-0.1.json",
  "title": "ProofFlow Research Event",
  "type": "object",
  "required": [
    "event_id",
    "project_id",
    "sequence",
    "event_type",
    "actor",
    "payload",
    "created_at",
    "previous_hash",
    "event_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "HUMAN",
            "MODEL",
            "PLUGIN",
            "SYSTEM"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic_delta": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "STRUCTURAL",
            "NONE"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
