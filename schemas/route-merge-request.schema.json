{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ActorType"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "model",
        "tool",
        "runtime"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_route_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 2,
      "title": "Source Route Ids",
      "type": "array"
    },
    "title": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 8000,
      "title": "Description",
      "type": "string"
    },
    "reason": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "supersede_sources": {
      "default": true,
      "title": "Supersede Sources",
      "type": "boolean"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    }
  },
  "required": [
    "source_route_ids",
    "title",
    "reason"
  ],
  "title": "RouteMergeRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemamath.org/schemas/runtime/route-merge-request.schema.json"
}
