{
  "schema_version": "0.3",
  "plugin_id": "python.local",
  "version": "0.1.0",
  "name": "Local Python Experiment Runner",
  "description": "Runs user-authored Python experiments in a dedicated venv and per-run directory. Process-only isolation; not an OS security sandbox.",
  "category": "COMPUTE",
  "runner_type": "python",
  "capabilities": [
    "finite_experiment",
    "symbolic_prototyping",
    "counterexample_search",
    "visualization_output"
  ],
  "install": {
    "type": "python_venv",
    "dependency_lock": [],
    "allow_network_install": false
  },
  "entrypoint": [],
  "healthcheck": [],
  "permissions": {
    "network": false,
    "filesystem_read": ["project_inputs"],
    "filesystem_write": ["run_workspace"],
    "environment_variables": [],
    "subprocess": true
  },
  "resources": {
    "max_cpu_seconds": 60,
    "max_memory_mb": 1024,
    "max_output_mb": 10,
    "timeout_seconds": 20
  },
  "isolation_level": "process-only",
  "default_timeout_seconds": 20,
  "maximum_timeout_seconds": 60,
  "enabled_by_default": false
}
